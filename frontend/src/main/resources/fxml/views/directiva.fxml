<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.DirectivaController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="members-scroll-pane">
    <content>
        <VBox spacing="18" styleClass="module-page, members-page">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- Hero -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="members-hero">
                <VBox spacing="4">
                    <Label text="GOBIERNO / JUNTA DIRECTIVA" styleClass="page-eyebrow"/>
                    <Label text="Junta directiva" styleClass="page-title, members-title"/>
                    <Label fx:id="lblNombrePeriodo" text="Período activo." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-box"
                          prefWidth="190" minWidth="140" prefHeight="38" minHeight="38" maxHeight="38">
                        <TextField fx:id="campoBusqueda" promptText="Buscar directivo..." HBox.hgrow="ALWAYS"
                                   styleClass="pill-search-field" prefHeight="36" minHeight="36" maxHeight="36"/>
                    </HBox>
                    <ComboBox fx:id="comboPeriodo" prefWidth="175" promptText="Seleccionar período"/>
                    <ComboBox fx:id="comboEstado" prefWidth="110" promptText="Estado"/>
                    <Button fx:id="btnRevocar" text="Revocar" onAction="#abrirModalRevocar" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-user-x"/></graphic>
                    </Button>
                    <Button fx:id="btnFinalizar" text="Finalizar" onAction="#finalizarAsignacion" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-check-circle"/></graphic>
                    </Button>
                    <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminarAsignacion" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
                    </Button>
                    <Button fx:id="btnRefrescar" onAction="#recargar" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                    </Button>
                    <Button fx:id="btnAsignarCargo" text="+ Asignar cargo" onAction="#abrirModalAsignacion"
                            styleClass="btn-primary-blue, members-primary-action"/>
                </HBox>
            </HBox>

            <!-- Tabla limpia -->
            <VBox spacing="0" styleClass="clean-table-card">
                <TableView fx:id="tablaDirectiva" styleClass="members-table">
                    <columns>
                        <TableColumn fx:id="columnaJerarquia" text="JERARQUÍA" prefWidth="100"/>
                        <TableColumn fx:id="columnaCargo" text="CARGO DIRECTIVO" prefWidth="190"/>
                        <TableColumn fx:id="columnaMiembro" text="MIEMBRO ASIGNADO" prefWidth="240"/>
                        <TableColumn fx:id="columnaContacto" text="CONTACTO (TEL / DUI)" prefWidth="180"/>
                        <TableColumn fx:id="columnaVigencia" text="VIGENCIA EN EL CARGO" prefWidth="220"/>
                        <TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="130"/>
                    </columns>
                    <placeholder><Label text="No hay cargos directivos asignados en este período" styleClass="page-subtitle"/></placeholder>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-footer-bar">
                    <Label fx:id="lblContadorFiltrados" text="0 cargos asignados" styleClass="footer-summary-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotalDirectivos" text="0 en funciones" styleClass="footer-summary-text"/>
                    <Label fx:id="lblNombrePresidente" text="" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px; -fx-text-fill: -color-accent-fg;"/>
                    <Label fx:id="lblEstadoPeriodo" text="" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
