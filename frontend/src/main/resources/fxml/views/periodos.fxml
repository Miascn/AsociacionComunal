<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.PeriodosController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="members-scroll-pane">
    <content>
        <VBox spacing="18" styleClass="module-page, members-page">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- Hero -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="members-hero">
                <VBox spacing="4">
                    <Label text="GOBIERNO / JUNTA DIRECTIVA" styleClass="page-eyebrow"/>
                    <Label text="Períodos directivos" styleClass="page-title, members-title"/>
                    <Label fx:id="lblPeriodoActivo" text="Sin período activo." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-box"
                          prefWidth="200" minWidth="150" prefHeight="38" minHeight="38" maxHeight="38">
                        <TextField fx:id="campoBusqueda" promptText="Buscar período..." HBox.hgrow="ALWAYS"
                                   styleClass="pill-search-field" prefHeight="36" minHeight="36" maxHeight="36"/>
                    </HBox>
                    <ComboBox fx:id="comboEstado" prefWidth="120" promptText="Estado"/>
                    <Button fx:id="btnNuevoPeriodo" text="+ Nuevo período" onAction="#abrirFormularioCrear"
                            styleClass="btn-primary-blue, members-primary-action"/>
                </HBox>
            </HBox>

            <!-- Tabla limpia -->
            <VBox spacing="0" styleClass="clean-table-card">
                <TableView fx:id="tablaPeriodos" styleClass="members-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="columnaNombre"   text="PERÍODO DIRECTIVO" minWidth="180" prefWidth="240"/>
                        <TableColumn fx:id="columnaInicio"   text="FECHA INICIO"      minWidth="110" maxWidth="130" prefWidth="120"/>
                        <TableColumn fx:id="columnaFin"      text="FECHA FIN"         minWidth="110" maxWidth="130" prefWidth="120"/>
                        <TableColumn fx:id="columnaRango"    text="VIGENCIA TEMPORAL" minWidth="150" prefWidth="200"/>
                        <TableColumn fx:id="columnaEstado"   text="ESTADO"            minWidth="110" maxWidth="130" prefWidth="120"/>
                        <TableColumn fx:id="columnaAcciones" text="ACCIONES"          minWidth="120" maxWidth="140" prefWidth="130" sortable="false" styleClass="col-acciones-header"/>
                    </columns>
                    <placeholder><Label text="No hay períodos directivos registrados" styleClass="page-subtitle"/></placeholder>
                </TableView>
                <HBox fx:id="barraPie" alignment="CENTER_LEFT" spacing="10" styleClass="table-footer-bar">
                    <Label fx:id="lblContadorFiltrados" text="0 períodos registrados" styleClass="footer-summary-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblVigenciaActiva" text="" styleClass="footer-summary-text"/>
                    <Label fx:id="lblTotalPlanificados" text="0 planificados" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px;"/>
                    <Label fx:id="lblTotalFinalizados" text="0 finalizados" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px; -fx-text-fill: -color-accent-fg;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
