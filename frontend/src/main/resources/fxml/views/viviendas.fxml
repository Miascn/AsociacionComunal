<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ViviendaController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="members-scroll-pane">
    <content>
        <VBox spacing="18" styleClass="module-page, members-page">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- Hero -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="members-hero">
                <VBox spacing="4">
                    <Label text="COMUNIDAD / CENSO" styleClass="page-eyebrow"/>
                    <Label text="Viviendas" styleClass="page-title, members-title"/>
                    <Label text="Administra hogares, residentes y composición familiar." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-box"
                          prefWidth="230" minWidth="160" prefHeight="38" minHeight="38" maxHeight="38">
                        <TextField fx:id="campoBusqueda" promptText="Buscar código, sector o dirección..." HBox.hgrow="ALWAYS"
                                   styleClass="pill-search-field" prefHeight="36" minHeight="36" maxHeight="36"/>
                    </HBox>
                    <Button fx:id="btnVerDetalle" text="Ver detalle" onAction="#verDetalle" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-eye"/></graphic>
                    </Button>
                    <Button fx:id="btnEditar" text="Editar" onAction="#editar" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                    </Button>
                    <Button fx:id="btnDesactivar" text="Desactivar" onAction="#desactivar" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-slash"/></graphic>
                    </Button>
                    <Button text="+ Nueva vivienda" onAction="#nueva" styleClass="btn-primary-blue, members-primary-action"/>
                </HBox>
            </HBox>

            <!-- Tabla limpia -->
            <VBox spacing="0" styleClass="clean-table-card">
                <TableView fx:id="tablaViviendas" styleClass="members-table">
                    <columns>
                        <TableColumn fx:id="colCodigo" text="CÓDIGO" prefWidth="100"/>
                        <TableColumn fx:id="colSector" text="SECTOR" prefWidth="150"/>
                        <TableColumn fx:id="colDireccion" text="DIRECCIÓN" prefWidth="320"/>
                        <TableColumn fx:id="colAdultos" text="ADULTOS" prefWidth="85"/>
                        <TableColumn fx:id="colMenores" text="MENORES" prefWidth="85"/>
                        <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="100"/>
                    </columns>
                    <placeholder><Label text="No hay viviendas registradas" styleClass="page-subtitle"/></placeholder>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-footer-bar">
                    <Label fx:id="lblTotal" text="0 viviendas registradas" styleClass="footer-summary-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblHabitantes" text="0 residentes" styleClass="footer-summary-text"/>
                    <Label fx:id="lblEstadoModulo" text="" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px; -fx-text-fill: -color-accent-fg;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
