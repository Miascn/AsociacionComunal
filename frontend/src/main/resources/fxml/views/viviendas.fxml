<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.ViviendaController" spacing="20" styleClass="module-page,members-page"><padding><Insets top="30" right="34" bottom="30" left="34"/></padding>
 <HBox alignment="CENTER_LEFT"><VBox spacing="6"><Label text="COMUNIDAD / CENSO" styleClass="page-eyebrow"/><Label text="Gestión de viviendas" styleClass="page-title,members-title"/><Label text="Administra hogares, representantes y composición familiar." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="NUEVA VIVIENDA" onAction="#nueva" styleClass="primary-action,members-primary-action"><graphic><FontIcon iconLiteral="fth-plus"/></graphic></Button></HBox>
 <HBox spacing="14"><HBox alignment="CENTER_LEFT" spacing="14" styleClass="summary-card,member-stat-card" HBox.hgrow="ALWAYS"><HBox alignment="CENTER" styleClass="summary-icon"><FontIcon iconLiteral="fth-home"/></HBox><VBox><Label text="VIVIENDAS REGISTRADAS" styleClass="summary-label"/><Label fx:id="lblTotal" text="0 viviendas" styleClass="summary-value"/></VBox></HBox><HBox alignment="CENTER_LEFT" spacing="14" styleClass="summary-card,member-stat-card" HBox.hgrow="ALWAYS"><HBox alignment="CENTER" styleClass="summary-icon,summary-icon-success"><FontIcon iconLiteral="fth-users"/></HBox><VBox><Label text="POBLACIÓN REGISTRADA" styleClass="summary-label"/><Label fx:id="lblHabitantes" text="0 residentes" styleClass="summary-value"/></VBox></HBox><VBox spacing="3" styleClass="summary-card" HBox.hgrow="ALWAYS"><Label text="ESTADO DEL SISTEMA" styleClass="summary-label"/><Label fx:id="lblEstadoModulo" text="Conectando..." styleClass="summary-value-success"/></VBox></HBox>
 <VBox spacing="0" styleClass="table-card,members-table-card" VBox.vgrow="ALWAYS"><HBox alignment="CENTER_LEFT" spacing="10" styleClass="members-toolbar"><VBox><Label text="Directorio de viviendas" styleClass="section-title"/><Label text="Selecciona una fila o haz doble clic para ver sus habitantes" styleClass="toolbar-caption"/></VBox><Region HBox.hgrow="ALWAYS"/><TextField fx:id="campoBusqueda" promptText="Buscar código, sector o representante" prefWidth="260" styleClass="search-field"/><Button fx:id="btnVerDetalle" text="Ver detalle" onAction="#verDetalle" styleClass="secondary-action"><graphic><FontIcon iconLiteral="fth-eye"/></graphic></Button><Button fx:id="btnEditar" text="Editar" onAction="#editar" styleClass="secondary-action"><graphic><FontIcon iconLiteral="fth-edit-2"/></graphic></Button><Button fx:id="btnDesactivar" text="Desactivar" onAction="#desactivar" styleClass="secondary-action"><graphic><FontIcon iconLiteral="fth-slash"/></graphic></Button></HBox>
  <TableView fx:id="tablaViviendas" VBox.vgrow="ALWAYS" styleClass="members-table"><columns><TableColumn fx:id="colCodigo" text="CÓDIGO" prefWidth="90"/><TableColumn fx:id="colSector" text="SECTOR" prefWidth="120"/><TableColumn fx:id="colDireccion" text="DIRECCIÓN" prefWidth="220"/><TableColumn fx:id="colRepresentante" text="REPRESENTANTE" prefWidth="180"/><TableColumn fx:id="colAdultos" text="ADULTOS" prefWidth="75"/><TableColumn fx:id="colMenores" text="MENORES" prefWidth="75"/><TableColumn fx:id="colEstado" text="ESTADO" prefWidth="90"/></columns><placeholder><Label text="No hay viviendas registradas" styleClass="page-subtitle"/></placeholder></TableView>
 </VBox>
</VBox>
