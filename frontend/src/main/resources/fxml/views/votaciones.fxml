<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.VotacionesController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="members-scroll-pane">
    <content>
        <VBox spacing="18" styleClass="module-page, members-page">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- Hero -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="members-hero">
                <VBox spacing="4">
                    <Label text="PARTICIPACIÓN CIUDADANA / ASAMBLEA" styleClass="page-eyebrow"/>
                    <Label text="Votaciones" styleClass="page-title, members-title"/>
                    <Label text="Elecciones directivas, consultas populares y reformas comunitarias." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-box"
                          prefWidth="210" minWidth="150" prefHeight="38" minHeight="38" maxHeight="38">
                        <TextField fx:id="txtBuscar" promptText="Buscar votación..." HBox.hgrow="ALWAYS"
                                   styleClass="pill-search-field" prefHeight="36" minHeight="36" maxHeight="36"/>
                    </HBox>
                    <ComboBox fx:id="comboEstado" prefWidth="130" promptText="Estado"/>
                    <Button onAction="#cargarDatos" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                    </Button>
                    <Button fx:id="btnNuevaVotacion" text="+ Nueva votación" onAction="#abrirFormularioCrear"
                            styleClass="btn-primary-blue, members-primary-action"/>
                </HBox>
            </HBox>

            <!-- Tabla limpia -->
            <VBox spacing="0" styleClass="clean-table-card">
                <TableView fx:id="tablaVotaciones" styleClass="members-table">
                    <columns>
                        <TableColumn fx:id="colTitulo" text="TÍTULO Y DESCRIPCIÓN" prefWidth="260"/>
                        <TableColumn fx:id="colProyecto" text="PROYECTO VINCULADO" prefWidth="180"/>
                        <TableColumn fx:id="colFechas" text="VIGENCIA (INICIO → FIN)" prefWidth="210"/>
                        <TableColumn fx:id="colOpcionesVotos" text="OPCIONES / VOTOS" prefWidth="150"/>
                        <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="120"/>
                        <TableColumn fx:id="colAcciones" text="ACCIONES" prefWidth="220"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>

                <!-- Panel de desglose de opciones (por votación seleccionada) -->
                <VBox fx:id="pnlDetalleOpciones" spacing="8"
                      style="-fx-background-color: #f8fafc; -fx-padding: 14; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="lblDetalleTitulo"
                               text="Selecciona una votación para ver sus opciones y resultados"
                               style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblDetalleEstado" text=""/>
                    </HBox>
                    <FlowPane fx:id="flowOpciones" hgap="12" vgap="8"/>
                </VBox>

                <!-- Pie de tabla -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-footer-bar">
                    <Label fx:id="lblContadorFiltrados" text="0 procesos registrados" styleClass="footer-summary-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotalAbiertas" text="0 abiertas" styleClass="footer-summary-text"/>
                    <Label fx:id="lblTotalBorradores" text="0 sin iniciar" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px;"/>
                    <Label fx:id="lblTotalVotos" text="0 votos emitidos" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px; -fx-text-fill: -color-accent-fg;"/>
                    <Label fx:id="lblTotalCerradas" text="" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px;"/>
                    <Label fx:id="lblAbiertasDetalle" text="" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
