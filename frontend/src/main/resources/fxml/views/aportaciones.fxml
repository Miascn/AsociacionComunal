<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AportacionesController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="members-scroll-pane">
    <content>
        <VBox spacing="18" styleClass="module-page, members-page">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- Hero -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="members-hero">
                <VBox spacing="4">
                    <Label text="FINANZAS / TESORERÍA" styleClass="page-eyebrow"/>
                    <Label text="Aportaciones" styleClass="page-title, members-title"/>
                    <Label text="Control y conciliación de aportaciones y pagos de vigilancia desde la app móvil." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-box"
                          prefWidth="200" minWidth="150" prefHeight="38" minHeight="38" maxHeight="38">
                        <TextField fx:id="campoBusqueda" promptText="Buscar miembro, DUI o ref..." HBox.hgrow="ALWAYS"
                                   styleClass="pill-search-field" prefHeight="36" minHeight="36" maxHeight="36"/>
                    </HBox>
                    <TextField fx:id="campoFiltroPeriodo" promptText="YYYY-MM" prefWidth="100" styleClass="pill-search-field"
                               prefHeight="38" minHeight="38" maxHeight="38"/>
                    <ComboBox fx:id="comboMetodo" prefWidth="115" promptText="Método"/>
                    <ComboBox fx:id="comboEstado" prefWidth="110" promptText="Estado"/>
                    <Button fx:id="btnVerRecibo" text="Recibo" onAction="#verRecibo" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-file-text"/></graphic>
                    </Button>
                    <Button fx:id="btnAnular" text="Anular" onAction="#anularAportacion" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-slash"/></graphic>
                    </Button>
                    <Button fx:id="btnRefrescar" onAction="#recargar" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                    </Button>
                </HBox>
            </HBox>

            <!-- Tabla limpia -->
            <VBox spacing="0" styleClass="clean-table-card">
                <TableView fx:id="tablaAportaciones" styleClass="members-table">
                    <columns>
                        <TableColumn fx:id="columnaFecha" text="FECHA PAGO" prefWidth="110"/>
                        <TableColumn fx:id="columnaMiembro" text="MIEMBRO" prefWidth="180"/>
                        <TableColumn fx:id="columnaDui" text="DUI" prefWidth="110"/>
                        <TableColumn fx:id="columnaPeriodo" text="PERÍODO" prefWidth="90"/>
                        <TableColumn fx:id="columnaMonto" text="MONTO" prefWidth="95"/>
                        <TableColumn fx:id="columnaMetodo" text="MÉTODO" prefWidth="110"/>
                        <TableColumn fx:id="columnaProyecto" text="PROYECTO" prefWidth="160"/>
                        <TableColumn fx:id="columnaReferencia" text="COMPROBANTE" prefWidth="130"/>
                        <TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="110"/>
                    </columns>
                    <placeholder><Label text="No se encontraron aportaciones registradas" styleClass="page-subtitle"/></placeholder>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-footer-bar">
                    <Label fx:id="lblTotalRegistros" text="0 aportaciones" styleClass="footer-summary-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotalRecaudado" text="$0.00 recaudado" styleClass="footer-summary-text"/>
                    <Label fx:id="lblPaginacion" text="Página 1 de 1" styleClass="footer-summary-text"/>
                    <Button fx:id="btnAnterior" text="←" onAction="#paginaAnterior" styleClass="btn-toggle-inactivos"/>
                    <Button fx:id="btnSiguiente" text="→" onAction="#paginaSiguiente" styleClass="btn-toggle-inactivos"/>
                    <Label fx:id="lblPeriodoActual" text="" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px; -fx-text-fill: -color-accent-fg;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
