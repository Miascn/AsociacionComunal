<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.MiembroController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="members-scroll-pane">
    <content>
        <VBox fx:id="contenedorPrincipal" spacing="18" styleClass="module-page, members-page">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- Hero: título + búsqueda + botones en la misma fila -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="members-hero">
                <VBox spacing="4">
                    <Label text="Gestión de miembros" styleClass="page-eyebrow"/>
                    <Label text="Miembros" styleClass="page-title, members-title"/>
                    <Label fx:id="lblSubtitulo" text="Listado de miembros activos." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-box"
                          prefWidth="260" minWidth="200" maxWidth="320"
                          prefHeight="38" minHeight="38" maxHeight="38">
                        <StackPane fx:id="iconoBusquedaContainer" alignment="CENTER"/>
                        <TextField fx:id="campoBusqueda" promptText="Buscar miembros..." HBox.hgrow="ALWAYS"
                                   styleClass="pill-search-field" prefHeight="36" minHeight="36" maxHeight="36"/>
                    </HBox>
                    <Button fx:id="btnToggleInactivos" text="Ver inactivos"
                            styleClass="btn-toggle-inactivos" onAction="#toggleFiltroInactivos"/>
                    <Button fx:id="btnNuevoMiembro" text="+ Registrar miembro"
                            styleClass="btn-primary-blue, members-primary-action" onAction="#abrirRegistro"/>
                </HBox>
            </HBox>

            <!-- Banner de Alerta: Credenciales Provisionales Pendientes de cambio en celular -->
            <HBox fx:id="bannerClavesProvisionales" alignment="CENTER_LEFT" spacing="14"
                  style="-fx-background-color: #fffbeb; -fx-border-color: #fde68a; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 12px 18px;"
                  visible="false" managed="false">
                <StackPane fx:id="iconoBannerContainer" alignment="CENTER"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Aviso de Seguridad: Contraseñas provisionales pendientes de cambio"
                           style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #92400e;"/>
                    <Label fx:id="lblBannerTexto"
                           text="Existen miembros que aún no han cambiado su contraseña temporal en el celular. Puede revisar y entregar sus credenciales hasta que lo hagan."
                           style="-fx-font-size: 12px; -fx-text-fill: #b45309;"/>
                </VBox>
                <Button fx:id="btnFiltrarProvisionales" text="Ver miembros pendientes"
                        style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 8px; -fx-padding: 6px 14px; -fx-cursor: hand;"
                        onAction="#filtrarProvisionales"/>
            </HBox>

            <!-- Tarjeta de tabla limpia -->
            <VBox fx:id="tarjetaTabla" spacing="0" styleClass="clean-table-card">
                <TableView fx:id="tablaMiembros" styleClass="members-table">
                    <columns>
                        <TableColumn fx:id="columnaDui" text="ID" prefWidth="75" minWidth="65" maxWidth="90"/>
                        <TableColumn fx:id="columnaNombres" text="NOMBRE" prefWidth="250" minWidth="180"/>
                        <TableColumn fx:id="columnaTelefono" text="TELÉFONO" prefWidth="130" minWidth="110" maxWidth="150"/>
                        <TableColumn fx:id="columnaCorreo" text="EMAIL" prefWidth="220" minWidth="150"/>
                        <TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="110" minWidth="95" maxWidth="130"/>
                        <TableColumn fx:id="columnaAcciones" text="ACCIONES" prefWidth="125" minWidth="115" maxWidth="135" sortable="false" styleClass="col-acciones-header"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="No hay miembros para mostrar en este filtro." styleClass="page-subtitle"/></placeholder>
                </TableView>

                <!-- Pie de tabla -->
                <HBox fx:id="barraPie" alignment="CENTER_LEFT" spacing="10" styleClass="table-footer-bar">
                    <Label fx:id="lblResumenPie" text="0 miembros · Mostrando activos" styleClass="footer-summary-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotalMiembros" text="0 registrados" styleClass="footer-summary-text"/>
                    <Label fx:id="lblEstadoModulo" text="" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px; -fx-text-fill: -color-accent-fg;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
