<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.MiembroController" spacing="22" styleClass="module-page">
    <padding><Insets top="30" right="34" bottom="30" left="34"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4">
            <Label text="Gestión de miembros" styleClass="page-title"/>
            <Label text="Administra el censo y la información de la comunidad" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo miembro" styleClass="primary-action" onAction="#abrirRegistro">
            <graphic><FontIcon iconLiteral="fth-user-plus"/></graphic>
        </Button>
    </HBox>

    <HBox spacing="14">
        <VBox spacing="4" styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="Total registrados" styleClass="summary-label"/>
            <Label fx:id="lblTotalMiembros" text="0 miembros registrados" styleClass="summary-value"/>
        </VBox>
        <VBox spacing="4" styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="Estado del módulo" styleClass="summary-label"/>
            <Label fx:id="lblEstadoModulo" text="Conectando al servidor..." styleClass="summary-value-success"/>
        </VBox>
    </HBox>

    <VBox spacing="12" styleClass="table-card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT">
            <Label text="Miembros registrados" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="campoBusqueda" promptText="Buscar por DUI, nombre o correo"
                       prefWidth="280" styleClass="search-field"/>
            <Button text="Exportar" styleClass="secondary-action">
                <graphic><FontIcon iconLiteral="fth-download"/></graphic>
            </Button>
        </HBox>
        <TableView fx:id="tablaMiembros" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="columnaDui" text="DUI" prefWidth="115"/>
                <TableColumn fx:id="columnaNombres" text="Nombres" prefWidth="145"/>
                <TableColumn fx:id="columnaApellidos" text="Apellidos" prefWidth="145"/>
                <TableColumn fx:id="columnaTelefono" text="Teléfono" prefWidth="105"/>
                <TableColumn fx:id="columnaCorreo" text="Correo" prefWidth="210"/>
                <TableColumn fx:id="columnaEstado" text="Estado" prefWidth="90"/>
            </columns>
            <placeholder><Label text="No hay miembros para mostrar" styleClass="page-subtitle"/></placeholder>
        </TableView>
    </VBox>
</VBox>
