<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CargosController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="members-scroll-pane">
    <content>
        <VBox spacing="18" styleClass="module-page, members-page">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- Hero -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="members-hero">
                <VBox spacing="4">
                    <Label text="GOBIERNO / JUNTA DIRECTIVA" styleClass="page-eyebrow"/>
                    <Label text="Cargos directivos" styleClass="page-title, members-title"/>
                    <Label text="Definición de responsabilidades, jerarquías de gobierno y control de puestos." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-box"
                          prefWidth="220" minWidth="160" prefHeight="38" minHeight="38" maxHeight="38">
                        <TextField fx:id="campoBusqueda" promptText="Buscar cargo o función..." HBox.hgrow="ALWAYS"
                                   styleClass="pill-search-field" prefHeight="36" minHeight="36" maxHeight="36"/>
                    </HBox>
                    <ComboBox fx:id="comboEstado" prefWidth="115" promptText="Estado"/>
                    <Button fx:id="btnNuevoCargo" text="+ Nuevo cargo" onAction="#abrirFormularioCrear"
                            styleClass="btn-primary-blue, members-primary-action"/>
                </HBox>
            </HBox>

            <!-- Tabla limpia -->
            <VBox spacing="0" styleClass="clean-table-card">
                <TableView fx:id="tablaCargos" styleClass="members-table">
                    <columns>
                        <TableColumn fx:id="columnaJerarquia"    text="JERARQUÍA"         prefWidth="105" minWidth="90"  maxWidth="120"/>
                        <TableColumn fx:id="columnaNombre"       text="CARGO"             prefWidth="170" minWidth="140" maxWidth="200"/>
                        <TableColumn fx:id="columnaDescripcion"  text="RESPONSABILIDADES" prefWidth="280" minWidth="200"/>
                        <TableColumn fx:id="columnaAsignaciones" text="ASIGNACIONES"      prefWidth="110" minWidth="95"  maxWidth="130"/>
                        <TableColumn fx:id="columnaEstado"       text="ESTADO"            prefWidth="85"  minWidth="75"  maxWidth="100"/>
                        <TableColumn fx:id="columnaAcciones"     text="ACCIONES"          prefWidth="130" minWidth="120" maxWidth="140" sortable="false" styleClass="col-acciones-header"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="No hay cargos directivos registrados" styleClass="page-subtitle"/></placeholder>
                </TableView>
                <HBox fx:id="barraPie" alignment="CENTER_LEFT" spacing="10" styleClass="table-footer-bar">
                    <Label fx:id="lblContadorFiltrados" text="0 cargos listados" styleClass="footer-summary-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblCargosActivos"    text="0 activos" styleClass="footer-summary-text"/>
                    <Label fx:id="lblTotalAsignaciones" text=""         styleClass="footer-summary-text"
                           style="-fx-font-size: 11px;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
