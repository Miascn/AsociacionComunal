<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CargosController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="members-scroll-pane">
    <content>
        <VBox spacing="18" styleClass="module-page, members-page">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- Hero -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="members-hero">
                <VBox spacing="4">
                    <Label text="GOBIERNO / JUNTA DIRECTIVA" styleClass="page-eyebrow"/>
                    <Label text="Cargos directivos" styleClass="page-title, members-title"/>
                    <Label text="Definición de responsabilidades, jerarquías de gobierno y control de puestos." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-box"
                          prefWidth="220" minWidth="160" prefHeight="38" minHeight="38" maxHeight="38">
                        <TextField fx:id="campoBusqueda" promptText="Buscar cargo o función..." HBox.hgrow="ALWAYS"
                                   styleClass="pill-search-field" prefHeight="36" minHeight="36" maxHeight="36"/>
                    </HBox>
                    <ComboBox fx:id="comboEstado" prefWidth="115" promptText="Estado"/>
                    <Button fx:id="btnEditar" text="Editar" onAction="#abrirFormularioEditar" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                    </Button>
                    <Button fx:id="btnToggleActivo" text="Activar/Desactivar" onAction="#toggleActivo" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-power"/></graphic>
                    </Button>
                    <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminarCargo" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
                    </Button>
                    <Button fx:id="btnRefrescar" onAction="#recargar" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                    </Button>
                    <Button fx:id="btnNuevoCargo" text="+ Nuevo cargo" onAction="#abrirFormularioCrear"
                            styleClass="btn-primary-blue, members-primary-action"/>
                </HBox>
            </HBox>

            <!-- Tabla limpia -->
            <VBox spacing="0" styleClass="clean-table-card">
                <TableView fx:id="tablaCargos" styleClass="members-table">
                    <columns>
                        <TableColumn fx:id="columnaJerarquia" text="JERARQUÍA" prefWidth="110"/>
                        <TableColumn fx:id="columnaNombre" text="CARGO" prefWidth="180"/>
                        <TableColumn fx:id="columnaDescripcion" text="RESPONSABILIDADES" prefWidth="300"/>
                        <TableColumn fx:id="columnaAsignaciones" text="ASIGNACIONES" prefWidth="120"/>
                        <TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="110"/>
                    </columns>
                    <placeholder><Label text="No hay cargos directivos registrados" styleClass="page-subtitle"/></placeholder>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-footer-bar">
                    <Label fx:id="lblContadorFiltrados" text="0 cargos listados" styleClass="footer-summary-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblCargosActivos" text="0 activos" styleClass="footer-summary-text"/>
                    <Label fx:id="lblTotalCargos" text="0 total" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px; -fx-text-fill: -color-accent-fg;"/>
                    <Label fx:id="lblTotalAsignaciones" text="" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
