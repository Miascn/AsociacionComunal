<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ProyectoController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="members-scroll-pane">
    <content>
        <VBox spacing="18" styleClass="module-page, members-page">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- Hero -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="members-hero">
                <VBox spacing="4">
                    <Label text="PROYECTOS / GESTIÓN COMUNAL" styleClass="page-eyebrow"/>
                    <Label text="Proyectos" styleClass="page-title, members-title"/>
                    <Label text="Planificación, aprobación y seguimiento de iniciativas comunitarias." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-box"
                          prefWidth="220" minWidth="160" prefHeight="38" minHeight="38" maxHeight="38">
                        <TextField fx:id="campoBusqueda" promptText="Buscar proyecto..." HBox.hgrow="ALWAYS"
                                   styleClass="pill-search-field" prefHeight="36" minHeight="36" maxHeight="36"/>
                    </HBox>
                    <ComboBox fx:id="comboEstado" prefWidth="130" promptText="Estado"/>
                    <Button fx:id="btnNuevoProyecto" text="+ Nuevo proyecto" onAction="#abrirFormularioCrear"
                            styleClass="btn-primary-blue, members-primary-action"/>
                </HBox>
            </HBox>

            <!-- Tabla limpia -->
            <VBox spacing="0" styleClass="clean-table-card">
                <TableView fx:id="tablaProyectos" styleClass="members-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="columnaNombre"      text="PROYECTO"     minWidth="150" prefWidth="180"/>
                        <TableColumn fx:id="columnaDescripcion" text="DESCRIPCIÓN"  minWidth="200" prefWidth="280"/>
                        <TableColumn fx:id="columnaPresupuesto" text="PRESUPUESTO"  minWidth="110" maxWidth="130" prefWidth="120"/>
                        <TableColumn fx:id="columnaFecha"       text="CREACIÓN"     minWidth="100" maxWidth="120" prefWidth="110"/>
                        <TableColumn fx:id="columnaCreador"     text="CREADO POR"   minWidth="110" maxWidth="150" prefWidth="130"/>
                        <TableColumn fx:id="columnaEstado"      text="ESTADO"       minWidth="110" maxWidth="130" prefWidth="120"/>
                        <TableColumn fx:id="columnaAcciones"    text="ACCIONES"     minWidth="110" maxWidth="130" prefWidth="120" sortable="false" styleClass="col-acciones-header"/>
                    </columns>
                    <placeholder><Label text="No hay proyectos comunales registrados" styleClass="page-subtitle"/></placeholder>
                </TableView>
                <HBox fx:id="barraPie" alignment="CENTER_LEFT" spacing="10" styleClass="table-footer-bar">
                    <Label fx:id="lblTotalProyectos" text="0 proyectos registrados" styleClass="footer-summary-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblEnEjecucion" text="0 en ejecución" styleClass="footer-summary-text"/>
                    <Label fx:id="lblPresupuestoTotal" text="USD 0.00" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px; -fx-text-fill: -color-accent-fg;"/>
                    <Label fx:id="lblAprobadosPropuestos" text="" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
