<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      spacing="22" styleClass="module-page">
    <padding><Insets top="30" right="34" bottom="30" left="34"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4">
            <Label text="Gestión de proyectos" styleClass="page-title"/>
            <Label text="Planifica y da seguimiento a las iniciativas de la comunidad" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo proyecto" styleClass="primary-action">
            <graphic><FontIcon iconLiteral="fth-plus-circle"/></graphic>
        </Button>
    </HBox>
    <HBox spacing="14">
        <VBox spacing="4" styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="Total de proyectos" styleClass="summary-label"/>
            <Label text="0" styleClass="summary-value"/>
        </VBox>
        <VBox spacing="4" styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="En ejecución" styleClass="summary-label"/>
            <Label text="0" styleClass="summary-value-accent"/>
        </VBox>
        <VBox spacing="4" styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="Presupuesto aprobado" styleClass="summary-label"/>
            <Label text="\$0.00" styleClass="summary-value-success"/>
        </VBox>
    </HBox>
    <VBox spacing="14" styleClass="table-card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Proyectos registrados" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="campoBusquedaProyecto" promptText="Buscar proyecto" prefWidth="240" styleClass="search-field"/>
            <ComboBox fx:id="filtroEstadoProyecto" promptText="Todos los estados" prefWidth="170" styleClass="filter-field"/>
            <Button text="Exportar" styleClass="secondary-action">
                <graphic><FontIcon iconLiteral="fth-download"/></graphic>
            </Button>
        </HBox>
        <TableView fx:id="tablaProyectos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="columnaNombreProyecto" text="Proyecto" prefWidth="220"/>
                <TableColumn fx:id="columnaDescripcionProyecto" text="Descripción" prefWidth="280"/>
                <TableColumn fx:id="columnaPresupuestoProyecto" text="Presupuesto" prefWidth="130"/>
                <TableColumn fx:id="columnaFechaProyecto" text="Fecha de creación" prefWidth="135"/>
                <TableColumn fx:id="columnaEstadoProyecto" text="Estado" prefWidth="125"/>
            </columns>
            <placeholder>
                <VBox alignment="CENTER" spacing="8">
                    <FontIcon iconLiteral="fth-folder" iconSize="34" styleClass="empty-icon"/>
                    <Label text="Todavía no hay proyectos registrados" styleClass="page-subtitle"/>
                    <Label text="Utiliza “Nuevo proyecto” para comenzar" styleClass="empty-hint"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
