<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.BitacoraController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="members-scroll-pane">
    <content>
        <VBox spacing="18" styleClass="module-page, members-page">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- Hero -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="members-hero">
                <VBox spacing="4">
                    <Label text="SEGURIDAD / AUDITORÍA" styleClass="page-eyebrow"/>
                    <Label text="Bitácora del sistema" styleClass="page-title, members-title"/>
                    <Label text="Registro cronológico e inmutable de operaciones críticas." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-box"
                          prefWidth="220" minWidth="160" prefHeight="38" minHeight="38" maxHeight="38">
                        <TextField fx:id="campoBusqueda" promptText="Buscar usuario o detalle..." HBox.hgrow="ALWAYS"
                                   styleClass="pill-search-field" prefHeight="36" minHeight="36" maxHeight="36"/>
                    </HBox>
                    <ComboBox fx:id="comboEntidad" prefWidth="120" promptText="Entidad"/>
                    <ComboBox fx:id="comboAccion" prefWidth="110" promptText="Acción"/>
                </HBox>
            </HBox>

            <!-- Tabla limpia -->
            <VBox spacing="0" styleClass="clean-table-card">
                <TableView fx:id="tablaBitacora" styleClass="members-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="columnaFecha"      text="FECHA Y HORA"        minWidth="130" maxWidth="160" prefWidth="145"/>
                        <TableColumn fx:id="columnaUsuario"    text="USUARIO"             minWidth="110" maxWidth="140" prefWidth="125"/>
                        <TableColumn fx:id="columnaAccion"     text="ACCIÓN"              minWidth="90" maxWidth="120" prefWidth="100"/>
                        <TableColumn fx:id="columnaEntidad"    text="ENTIDAD"             minWidth="90" maxWidth="120" prefWidth="100"/>
                        <TableColumn fx:id="columnaIdRegistro" text="ID REGISTRO"         minWidth="80" maxWidth="100" prefWidth="90"/>
                        <TableColumn fx:id="columnaDetalle"    text="DETALLE DEL EVENTO"  minWidth="200" prefWidth="320"/>
                        <TableColumn fx:id="columnaAcciones"   text="ACCIONES"            minWidth="80" maxWidth="100" prefWidth="90" sortable="false" styleClass="col-acciones-header"/>
                    </columns>
                    <placeholder><Label text="No hay eventos registrados en la bitácora" styleClass="page-subtitle"/></placeholder>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-footer-bar">
                    <Label fx:id="lblTotalEventos" text="0 eventos registrados" styleClass="footer-summary-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER_RIGHT" spacing="8" styleClass="pagination-box">
                        <Label text="Filas:" styleClass="pagination-label"/>
                        <ComboBox fx:id="comboPageSize" prefWidth="75" styleClass="combo-pagination"/>
                        <Button fx:id="btnAnterior" text="←" onAction="#paginaAnterior" styleClass="btn-pagination"/>
                        <Label fx:id="lblPaginacion" text="Pág. 1 de 1" styleClass="pagination-info"/>
                        <Button fx:id="btnSiguiente" text="→" onAction="#paginaSiguiente" styleClass="btn-pagination"/>
                    </HBox>
                    <Label fx:id="lblEstadoModulo" text="Inmutable · Solo lectura" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px; -fx-text-fill: -color-accent-fg;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
