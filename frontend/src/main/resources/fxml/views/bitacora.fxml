<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.BitacoraController" spacing="20" styleClass="module-page, members-page">
    <padding><Insets top="28" right="34" bottom="28" left="34"/></padding>

    <!-- Encabezado de la página -->
    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="members-hero">
        <VBox spacing="6">
            <Label text="SEGURIDAD / AUDITORÍA" styleClass="page-eyebrow"/>
            <Label text="Bitácora del sistema" styleClass="page-title, members-title"/>
            <Label text="Registro cronológico e inmutable de operaciones críticas y eventos del sistema." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="8" styleClass="summary-icon, summary-icon-success">
            <FontIcon iconLiteral="fth-shield"/>
        </HBox>
    </HBox>

    <!-- Tarjetas de resumen -->
    <HBox spacing="14">
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="summary-card, member-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER" styleClass="summary-icon"><FontIcon iconLiteral="fth-file-text"/></HBox>
            <VBox spacing="3">
                <Label text="EVENTOS REGISTRADOS" styleClass="summary-label"/>
                <Label fx:id="lblTotalEventos" text="0 eventos" styleClass="summary-value"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="summary-card, member-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER" styleClass="summary-icon, summary-icon-success"><FontIcon iconLiteral="fth-lock"/></HBox>
            <VBox spacing="3">
                <Label text="POLÍTICA DE AUDITORÍA" styleClass="summary-label"/>
                <Label fx:id="lblEstadoModulo" text="Inmutable • Solo lectura" styleClass="summary-value-success"/>
            </VBox>
        </HBox>
    </HBox>

    <!-- Contenedor principal de la tabla con barra de filtros -->
    <VBox spacing="0" styleClass="table-card, members-table-card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="members-toolbar">
            <VBox spacing="2">
                <Label text="Eventos de auditoría" styleClass="section-title"/>
                <Label text="Trazabilidad y registro de actividad por usuario y entidad" styleClass="toolbar-caption"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Filtro de Entidad -->
            <ComboBox fx:id="comboEntidad" prefWidth="130" promptText="Entidad"/>

            <!-- Filtro de Acción -->
            <ComboBox fx:id="comboAccion" prefWidth="130" promptText="Acción"/>

            <!-- Búsqueda rápida -->
            <HBox alignment="CENTER_LEFT" spacing="6" styleClass="search-box">
                <FontIcon iconLiteral="fth-search"/>
                <TextField fx:id="campoBusqueda" promptText="Buscar usuario o detalle" prefWidth="200" styleClass="search-field"/>
            </HBox>

            <Button fx:id="btnVerDetalle" text="Ver detalle" onAction="#verDetalle" styleClass="secondary-action">
                <graphic><FontIcon iconLiteral="fth-info"/></graphic>
            </Button>
            <Button fx:id="btnRefrescar" text="Actualizar" onAction="#recargar" styleClass="secondary-action">
                <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
            </Button>
        </HBox>

        <!-- Tabla de bitácora -->
        <TableView fx:id="tablaBitacora" VBox.vgrow="ALWAYS" styleClass="members-table">
            <columns>
                <TableColumn fx:id="columnaFecha" text="FECHA Y HORA" prefWidth="160"/>
                <TableColumn fx:id="columnaUsuario" text="USUARIO" prefWidth="140"/>
                <TableColumn fx:id="columnaAccion" text="ACCIÓN" prefWidth="110"/>
                <TableColumn fx:id="columnaEntidad" text="ENTIDAD" prefWidth="110"/>
                <TableColumn fx:id="columnaIdRegistro" text="ID REGISTRO" prefWidth="95"/>
                <TableColumn fx:id="columnaDetalle" text="DETALLE DEL EVENTO" prefWidth="320"/>
            </columns>
            <placeholder><Label text="No hay eventos registrados en la bitácora" styleClass="page-subtitle"/></placeholder>
        </TableView>

        <!-- Barra inferior de paginación -->
        <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 10 16 10 16; -fx-background-color: -color-bg-inset;">
            <Label fx:id="lblPaginacion" text="Página 1 de 1" styleClass="toolbar-caption"/>
            <Button fx:id="btnAnterior" text="← Anterior" onAction="#paginaAnterior" styleClass="secondary-action"/>
            <Button fx:id="btnSiguiente" text="Siguiente →" onAction="#paginaSiguiente" styleClass="secondary-action"/>
        </HBox>
    </VBox>
</VBox>
