<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.UsuarioFormController" spacing="13">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
    <Label fx:id="lblTitulo" text="Nuevo usuario" styleClass="page-title"/>
    <Label text="Nombre de usuario *"/><TextField fx:id="campoUsuario" promptText="Ejemplo: maria.lopez"/>
    <Label text="Contraseña *"/><PasswordField fx:id="campoClave" promptText="Mínimo 8 caracteres"/>
    <Label text="Rol *"/><ComboBox fx:id="selectorRol" maxWidth="Infinity"/>
    <Label text="Miembro asociado"/><ComboBox fx:id="selectorMiembro" maxWidth="Infinity"/>
    <Label text="Estado"/><ComboBox fx:id="selectorEstado" maxWidth="Infinity"/>
    <Label fx:id="lblError" wrapText="true" style="-fx-text-fill: #c0392b;"/>
</VBox>
