<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.DashboardController"
      spacing="24" styleClass="dashboard-root">
    <padding>
        <Insets top="28" right="32" bottom="28" left="32"/>
    </padding>

    <VBox spacing="2">
        <Label text="Panel general" styleClass="page-title"/>
        <Label text="Resumen de la asociación (datos de prueba - Fase 1)" styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="20">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="fth-users" styleClass="stat-icon"/>
            <Label fx:id="lblMiembros" styleClass="stat-value"/>
            <Label text="Miembros activos" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="fth-home" styleClass="stat-icon"/>
            <Label fx:id="lblFamilias" styleClass="stat-value"/>
            <Label text="Familias registradas" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="fth-dollar-sign" styleClass="stat-icon, stat-icon-success"/>
            <Label fx:id="lblIngresos" styleClass="stat-value"/>
            <Label text="Ingresos del período" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="fth-briefcase" styleClass="stat-icon, stat-icon-warning"/>
            <Label fx:id="lblProyectos" styleClass="stat-value"/>
            <Label text="Proyectos activos" styleClass="stat-label"/>
        </VBox>
    </HBox>
</VBox>
