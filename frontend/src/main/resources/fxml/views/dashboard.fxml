<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:id="dashboardScrollPane"
            fx:controller="controller.DashboardController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll">
 <VBox spacing="20" styleClass="dashboard-root">
  <padding><Insets top="24" right="28" bottom="36" left="28"/></padding>

  <!-- Encabezado con estado en vivo y refresco -->
  <HBox alignment="CENTER_LEFT" spacing="14" styleClass="dashboard-header-bar">
   <VBox spacing="2">
    <Label text="Dashboard" styleClass="page-title"/>
    <Label text="Panel general y estado en vivo de la comunidad" styleClass="page-subtitle"/>
   </VBox>
   <Region HBox.hgrow="ALWAYS"/>
   <HBox alignment="CENTER_RIGHT" spacing="10">
    <Label fx:id="lblEstadoConexion" text="● Conectado a la API" styleClass="dashboard-status-badge"/>
    <Label fx:id="lblFechaActual" styleClass="panel-chip"/>
    <Button fx:id="btnActualizar" text="Actualizar" onAction="#onActualizar" styleClass="btn-dashboard-refresh">
     <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
    </Button>
   </HBox>
  </HBox>

  <!-- Tarjetas KPI Principales -->
  <HBox spacing="14">
   <!-- Miembros -->
   <HBox alignment="CENTER_LEFT" spacing="14" styleClass="stat-card" HBox.hgrow="ALWAYS">
    <FontIcon iconLiteral="fth-users" styleClass="stat-icon"/>
    <VBox spacing="3">
     <Label text="Miembros activos" styleClass="stat-label"/>
     <Label fx:id="lblMiembros" text="--" styleClass="stat-value"/>
     <HBox spacing="6" alignment="CENTER_LEFT">
      <Label fx:id="lblMiembrosTotal" text="Cargando..." styleClass="stat-trend"/>
     </HBox>
    </VBox>
   </HBox>

   <!-- Viviendas / Censo -->
   <HBox alignment="CENTER_LEFT" spacing="14" styleClass="stat-card" HBox.hgrow="ALWAYS">
    <FontIcon iconLiteral="fth-home" styleClass="stat-icon stat-icon-cyan"/>
    <VBox spacing="3">
     <Label text="Viviendas y familias" styleClass="stat-label"/>
     <Label fx:id="lblFamilias" text="--" styleClass="stat-value"/>
     <HBox spacing="6" alignment="CENTER_LEFT">
      <Label fx:id="lblHabitantesSub" text="Censo comunal" styleClass="stat-trend"/>
     </HBox>
    </VBox>
   </HBox>

   <!-- Aportaciones -->
   <HBox alignment="CENTER_LEFT" spacing="14" styleClass="stat-card" HBox.hgrow="ALWAYS">
    <FontIcon iconLiteral="fth-dollar-sign" styleClass="stat-icon stat-icon-success"/>
    <VBox spacing="3">
     <Label text="Aportaciones totales" styleClass="stat-label"/>
     <Label fx:id="lblIngresos" text="--" styleClass="stat-value"/>
     <HBox spacing="6" alignment="CENTER_LEFT">
      <Label fx:id="lblIngresosMesSub" text="Período actual" styleClass="stat-trend"/>
     </HBox>
    </VBox>
   </HBox>

   <!-- Proyectos -->
   <HBox alignment="CENTER_LEFT" spacing="14" styleClass="stat-card" HBox.hgrow="ALWAYS">
    <FontIcon iconLiteral="fth-briefcase" styleClass="stat-icon stat-icon-warning"/>
    <VBox spacing="3">
     <Label text="Proyectos comunitarios" styleClass="stat-label"/>
     <Label fx:id="lblProyectos" text="--" styleClass="stat-value"/>
     <HBox spacing="6" alignment="CENTER_LEFT">
      <Label fx:id="lblProyectosSub" text="En seguimiento" styleClass="stat-trend"/>
     </HBox>
    </VBox>
   </HBox>
  </HBox>

  <!-- Sección Intermedia: Gráfico mensual + Actividades y Acciones -->
  <HBox spacing="16">
   <VBox spacing="16" HBox.hgrow="ALWAYS">
    <!-- Gráfico dinámico de aportaciones -->
    <VBox spacing="12" styleClass="dashboard-panel" VBox.vgrow="ALWAYS">
     <HBox alignment="CENTER_LEFT">
      <VBox spacing="2">
       <Label text="Aportaciones mensuales" styleClass="section-title"/>
       <Label text="Recaudación real registrada en los últimos 6 meses" styleClass="muted-label"/>
      </VBox>
      <Region HBox.hgrow="ALWAYS"/>
      <Label text="Últimos 6 meses" styleClass="panel-chip"/>
     </HBox>

     <!-- Contenedor dinámico de barras mensuales -->
     <HBox fx:id="chartBarsContainer" alignment="BOTTOM_CENTER" spacing="24" prefHeight="170" styleClass="bar-chart-mock">
      <!-- Se puebla dinámicamente desde DashboardController -->
     </HBox>
    </VBox>

    <!-- Actividad reciente (Bitácora) -->
    <VBox spacing="10" styleClass="dashboard-panel">
     <HBox alignment="CENTER_LEFT">
      <Label text="Actividad reciente del sistema" styleClass="section-title"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label text="Bitácora en vivo" styleClass="panel-chip"/>
     </HBox>
     <VBox fx:id="boxActividadReciente" spacing="8" styleClass="activity-list-container">
      <Label text="Cargando actividades..." styleClass="muted-label"/>
     </VBox>
    </VBox>
   </VBox>

   <!-- Columna derecha: Próximas asambleas y Acciones rápidas -->
   <VBox prefWidth="320" minWidth="280" spacing="16">
    <!-- Próximas actividades -->
    <VBox spacing="12" styleClass="dashboard-panel">
     <HBox alignment="CENTER_LEFT">
      <Label text="Próximas actividades" styleClass="section-title"/>
      <Region HBox.hgrow="ALWAYS"/>
      <FontIcon iconLiteral="fth-calendar" styleClass="muted-icon"/>
     </HBox>
     <VBox fx:id="boxProximasActividades" spacing="8">
      <Label text="Cargando asambleas..." styleClass="muted-label"/>
     </VBox>
    </VBox>

    <!-- Acciones rápidas -->
    <VBox spacing="10" styleClass="dashboard-panel">
     <Label text="Acciones rápidas" styleClass="section-title"/>
     <Button fx:id="btnQuickMiembro" text="Registrar miembro" onAction="#onRegistrarMiembro" maxWidth="Infinity" styleClass="quick-action">
      <graphic><FontIcon iconLiteral="fth-user-plus"/></graphic>
     </Button>
     <Button fx:id="btnQuickVivienda" text="Nueva vivienda" onAction="#onNuevaVivienda" maxWidth="Infinity" styleClass="quick-action">
      <graphic><FontIcon iconLiteral="fth-home"/></graphic>
     </Button>
     <Button fx:id="btnQuickAportacion" text="Registrar aportación" onAction="#onRegistrarAportacion" maxWidth="Infinity" styleClass="quick-action">
      <graphic><FontIcon iconLiteral="fth-dollar-sign"/></graphic>
     </Button>
     <Button fx:id="btnQuickReunion" text="Programar reunión" onAction="#onProgramarReunion" maxWidth="Infinity" styleClass="quick-action">
      <graphic><FontIcon iconLiteral="fth-calendar"/></graphic>
     </Button>
    </VBox>
   </VBox>
  </HBox>

  <!-- SECCIÓN INFERIOR PROMINENTE: MAPA COMUNITARIO ESTILO GOOGLE MAPS -->
  <VBox spacing="12" styleClass="dashboard-panel, dashboard-map-panel">
   <HBox alignment="CENTER_LEFT" spacing="10">
    <VBox spacing="2">
     <HBox alignment="CENTER_LEFT" spacing="8">
      <FontIcon iconLiteral="fth-map" styleClass="map-section-title-icon"/>
      <Label text="Plano Urbanístico Comunal • Sectores A, B, C y D" styleClass="section-title"/>
     </HBox>
     <Label text="Plano arquitectónico interactivo de la colonia. Cada casa en el plano corresponde a una vivienda registrada en el sistema." styleClass="muted-label"/>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="lblMapStats" text="Cargando viviendas..." styleClass="panel-chip"/>
   </HBox>

   <!-- Contenedor del mapa y panel de herramientas a la par -->
   <HBox alignment="CENTER" fillHeight="false">
    <StackPane fx:id="mapContainer" alignment="CENTER" prefWidth="1024" maxWidth="1060" minWidth="880">
     <!-- Aquí se inyecta CommunityMapPane -->
    </StackPane>
   </HBox>

   <!-- Ficha rápida de vivienda seleccionada -->
   <HBox fx:id="panelDetalleViviendaMapa" visible="false" managed="false" alignment="CENTER_LEFT" spacing="18" styleClass="map-selected-house-bar">
    <FontIcon iconLiteral="fth-home" styleClass="stat-icon stat-icon-cyan"/>
    <VBox spacing="2">
     <Label fx:id="lblDetalleCodigo" text="Casa C-01" styleClass="feature-title"/>
     <Label fx:id="lblDetalleDireccion" text="Pasaje Los Almendros #1" styleClass="muted-label"/>
    </VBox>
    <Separator orientation="VERTICAL"/>
    <VBox spacing="2">
     <Label fx:id="lblDetalleRepresentante" text="Representante: --" styleClass="map-bar-info-text"/>
     <Label fx:id="lblDetalleHabitantes" text="-- habitantes censados" styleClass="muted-label"/>
    </VBox>
    <Separator orientation="VERTICAL"/>
    <Label fx:id="lblDetalleEstado" text="ACTIVA" styleClass="map-callout-badge, badge-ocupada"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="btnAbrirExpediente" text="Ver Expediente de Vivienda" onAction="#onAbrirExpedienteSeleccionado" styleClass="btn-primary-action">
     <graphic><FontIcon iconLiteral="fth-external-link"/></graphic>
    </Button>
   </HBox>
  </VBox>

 </VBox>
</ScrollPane>

