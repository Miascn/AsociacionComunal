<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="sv.asociacion.controller.DashboardController"
      spacing="24" styleClass="dashboard-root">
    <padding>
        <Insets top="28" right="32" bottom="28" left="32"/>
    </padding>

    <VBox spacing="2">
        <Label text="Panel General" styleClass="page-title"/>
        <Label text="Resumen de la asociación (datos de prueba — Fase 1)" styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="20">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="fth-users" styleClass="stat-icon"/>
            <Label fx:id="lblTotalMiembros" styleClass="stat-value"/>
            <Label text="Miembros activos" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="fth-check-circle" styleClass="stat-icon stat-icon-success"/>
            <Label fx:id="lblCuotasAlDia" styleClass="stat-value"/>
            <Label text="Cuotas al día" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="fth-alert-circle" styleClass="stat-icon stat-icon-warning"/>
            <Label fx:id="lblCuotasVencidas" styleClass="stat-value"/>
            <Label text="Cuotas vencidas" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="fth-calendar" styleClass="stat-icon"/>
            <Label fx:id="lblProximaAsamblea" styleClass="stat-value"/>
            <Label text="Próxima asamblea" styleClass="stat-label"/>
        </VBox>
    </HBox>
</VBox>
