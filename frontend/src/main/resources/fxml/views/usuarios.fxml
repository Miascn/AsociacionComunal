<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.UsuarioController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="members-scroll-pane">
    <content>
        <VBox spacing="18" styleClass="module-page, members-page">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- Hero -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="members-hero">
                <VBox spacing="4">
                    <Label text="SEGURIDAD / ACCESO" styleClass="page-eyebrow"/>
                    <Label text="Usuarios" styleClass="page-title, members-title"/>
                    <Label text="Administra cuentas, roles y estados de acceso al sistema." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-box"
                          prefWidth="240" minWidth="180" prefHeight="38" minHeight="38" maxHeight="38">
                        <TextField fx:id="campoBusqueda" promptText="Buscar usuario, rol o miembro..." HBox.hgrow="ALWAYS"
                                   styleClass="pill-search-field" prefHeight="36" minHeight="36" maxHeight="36"/>
                    </HBox>
                    <Button fx:id="btnEditar" text="Editar" onAction="#edit" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                    </Button>
                    <Button fx:id="btnCambiarEstado" text="Estado" onAction="#changeState" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                    </Button>
                    <Button fx:id="btnBloquear" text="Bloquear" onAction="#bloquearUsuario" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-slash"/></graphic>
                    </Button>
                    <Button fx:id="btnRestablecerClave" text="Clave" onAction="#restablecerClave" styleClass="btn-toggle-inactivos">
                        <graphic><FontIcon iconLiteral="fth-key"/></graphic>
                    </Button>
                    <Button text="+ Nuevo usuario" onAction="#create" styleClass="btn-primary-blue, members-primary-action"/>
                </HBox>
            </HBox>

            <!-- Tabla limpia -->
            <VBox spacing="0" styleClass="clean-table-card">
                <TableView fx:id="tablaUsuarios" styleClass="members-table">
                    <columns>
                        <TableColumn fx:id="columnaUsuario" text="USUARIO" prefWidth="155"/>
                        <TableColumn fx:id="columnaRol" text="ROL" prefWidth="130"/>
                        <TableColumn fx:id="columnaMiembro" text="MIEMBRO ASOCIADO" prefWidth="220"/>
                        <TableColumn fx:id="columnaEstado" text="ESTADO" prefWidth="105"/>
                        <TableColumn fx:id="columnaUltimoAcceso" text="ÚLTIMO ACCESO" prefWidth="180"/>
                    </columns>
                    <placeholder><Label text="Aún no hay usuarios para mostrar" styleClass="page-subtitle"/></placeholder>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-footer-bar">
                    <Label fx:id="lblTotalUsuarios" text="0 usuarios registrados" styleClass="footer-summary-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblEstadoModulo" text="" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px; -fx-text-fill: -color-accent-fg;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
