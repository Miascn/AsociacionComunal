<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.UsuarioController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="members-scroll-pane">
    <content>
        <VBox spacing="18" styleClass="module-page, members-page">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <!-- Hero -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="members-hero">
                <VBox spacing="4">
                    <Label text="SEGURIDAD / ACCESO" styleClass="page-eyebrow"/>
                    <Label text="Usuarios" styleClass="page-title, members-title"/>
                    <Label text="Administra cuentas, roles y accesos segregados entre el sistema de escritorio Java y la app móvil." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-box"
                          prefWidth="260" minWidth="180" prefHeight="38" minHeight="38" maxHeight="38">
                        <TextField fx:id="campoBusqueda" promptText="Buscar usuario, rol o miembro..." HBox.hgrow="ALWAYS"
                                   styleClass="pill-search-field" prefHeight="36" minHeight="36" maxHeight="36"/>
                    </HBox>
                    <Button text="+ Nuevo usuario" onAction="#create" styleClass="btn-primary-blue, members-primary-action"/>
                </HBox>
            </HBox>

            <!-- Pestañas de Segmentación de Usuarios (Sistema Java vs App Móvil) -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 4px 0;">
                <Button fx:id="btnTabSistema" text="💻 Usuarios del Sistema (Java)"
                        onAction="#seleccionarTabSistema"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 9999px; -fx-padding: 8px 18px; -fx-cursor: hand; -fx-font-size: 13px;"/>
                <Button fx:id="btnTabMovil" text="📱 Cuentas de la App Móvil (Residentes)"
                        onAction="#seleccionarTabMovil"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: 700; -fx-background-radius: 9999px; -fx-padding: 8px 18px; -fx-cursor: hand; -fx-font-size: 13px;"/>
                <Button fx:id="btnTabTodos" text="🌐 Todos los Usuarios"
                        onAction="#seleccionarTabTodos"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: 700; -fx-background-radius: 9999px; -fx-padding: 8px 18px; -fx-cursor: hand; -fx-font-size: 13px;"/>
            </HBox>

            <!-- Banner Contextual del Segmento Activo -->
            <HBox fx:id="bannerContexto" alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #eff6ff; -fx-border-color: #bfdbfe; -fx-border-width: 1px; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 10px 16px;">
                <Label fx:id="lblIconoContexto" text="ℹ️" style="-fx-font-size: 14px;"/>
                <Label fx:id="lblDescripcionSegmento"
                       text="Mostrando usuarios administrativos con acceso al sistema de escritorio Java (Administradores y Directiva). Las cuentas de residentes para la app móvil se aíslan en su pestaña correspondiente."
                       style="-fx-text-fill: #1e40af; -fx-font-size: 12px; -fx-font-weight: 600;" HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Tabla limpia -->
            <VBox spacing="0" styleClass="clean-table-card">
                <TableView fx:id="tablaUsuarios" styleClass="members-table">
                    <columns>
                        <TableColumn fx:id="columnaUsuario"     text="USUARIO"          prefWidth="130" minWidth="110" maxWidth="160"/>
                        <TableColumn fx:id="columnaTipo"        text="APLICACIÓN"       prefWidth="140" minWidth="120" maxWidth="160"/>
                        <TableColumn fx:id="columnaRol"         text="ROL"              prefWidth="120" minWidth="100" maxWidth="140"/>
                        <TableColumn fx:id="columnaMiembro"     text="MIEMBRO ASOCIADO" prefWidth="200" minWidth="160"/>
                        <TableColumn fx:id="columnaEstado"      text="ESTADO"           prefWidth="90"  minWidth="80"  maxWidth="105"/>
                        <TableColumn fx:id="columnaUltimoAcceso" text="ÚLTIMO ACCESO"   prefWidth="140" minWidth="120" maxWidth="160"/>
                        <TableColumn fx:id="columnaAcciones"    text="ACCIONES"         prefWidth="160" minWidth="140" maxWidth="180" sortable="false" styleClass="col-acciones-header"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="Aún no hay usuarios para mostrar" styleClass="page-subtitle"/></placeholder>
                </TableView>
                <HBox fx:id="barraPie" alignment="CENTER_LEFT" spacing="10" styleClass="table-footer-bar">
                    <Label fx:id="lblTotalUsuarios" text="0 usuarios" styleClass="footer-summary-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblEstadoModulo" text="" styleClass="footer-summary-text"
                           style="-fx-font-size: 11px; -fx-text-fill: -color-accent-fg;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
