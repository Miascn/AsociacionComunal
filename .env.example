# Copie este archivo como .env y complete los valores.
# .env esta ignorado por Git y nunca debe subirse.
# Las variables de entorno del sistema tienen prioridad sobre .env.
# scripts/run.sh crea un .env local con secretos aleatorios si no existe.
API_PORT=8080
API_SHARED_SECRET=GENERAR_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_SECRET=GENERAR_OTRO_SECRETO_DE_AL_MENOS_32_CARACTERES
# Opcional: llave para cifrar las claves provisionales (usuario.clave_temporal).
# Si se omite, se deriva de JWT_SECRET. Cambiarla invalida las claves provisionales guardadas.
# CREDENTIALS_KEY=GENERAR_SECRETO_DE_AL_MENOS_32_CARACTERES

# Base de datos. Los valores coinciden con docker-compose.yml (solo entorno local).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=asociacion_comunal
DB_USER=asociacion_app
DB_PASSWORD=asociacion_local
